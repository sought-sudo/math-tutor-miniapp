/* 全局样式 */
page {
  background: #FFF8EC;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  color: #333;
  font-size: 30rpx;
  line-height: 1.6;
}

.page {
  padding: 24rpx 24rpx 180rpx;
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(255, 159, 28, 0.08);
}

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  padding: 20rpx 40rpx;
  font-size: 32rpx;
  font-weight: 700;
  box-sizing: border-box;
}
.btn:active {
  transform: scale(0.97);
  opacity: 0.9;
}

.btn-primary {
  background: linear-gradient(135deg, #FFB400, #FF8A00);
  color: #fff;
  box-shadow: 0 8rpx 18rpx rgba(255, 154, 0, 0.35);
}
.btn-blue {
  background: linear-gradient(135deg, #5DA5FF, #3A7BFF);
  color: #fff;
}
.btn-green {
  background: linear-gradient(135deg, #35D0AA, #14A98C);
  color: #fff;
}
.btn-warn {
  background: #FFE9E3;
  color: #FF6B6B;
}
.btn-ghost {
  background: #fff;
  color: #FF8A00;
  border: 2rpx solid #FFD08A;
}

.btn-small {
  display: inline-flex;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
}

.tag {
  display: inline-block;
  background: #FFF4E0;
  color: #FF8A00;
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 999rpx;
}

.label {
  font-size: 30rpx;
  color: #444;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.note {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.6;
}

.empty {
  text-align: center;
  color: #999;
  padding: 48rpx 0 8rpx;
  font-size: 28rpx;
}
.empty-sub {
  text-align: center;
  font-size: 24rpx;
  color: #bbb;
  margin-top: 8rpx;
}
