.code-card {
  text-align: center;
  background: linear-gradient(135deg, #FFC53D, #FF9F1C);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(255, 159, 28, 0.3);
}

.code-label {
  font-size: 24rpx;
  opacity: 0.95;
}

.code {
  font-size: 64rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  margin: 12rpx 0 20rpx;
  word-break: break-all;
}

.code-card .btn {
  display: inline-flex;
}

.name-row {
  display: flex;
  align-items: center;
}

.name {
  font-size: 32rpx;
  font-weight: 700;
  flex: 1;
}

.name-input {
  flex: 1;
  background: #FFF9EE;
  border: 2rpx solid #FFE3B3;
  border-radius: 12rpx;
  padding: 12rpx 20rpx;
  font-size: 30rpx;
  margin-right: 16rpx;
}

.sync-on {
  color: #14A98C;
  font-weight: 700;
}

.sync-off {
  color: #FF8A00;
  font-weight: 700;
}

.step-row {
  font-size: 28rpx;
  color: #444;
  margin-bottom: 14rpx;
  line-height: 1.7;
}

.step-row.url {
  color: #3A7BFF;
  font-weight: 700;
  word-break: break-all;
}

.stats-row {
  display: flex;
}

.stat {
  flex: 1;
  text-align: center;
}

.stat .num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF8A00;
}

.stat .lbl {
  font-size: 22rpx;
  color: #999;
}

.note-card {
  text-align: center;
}
