.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #FFC53D, #FF9F1C);
  color: #fff;
  box-shadow: 0 10rpx 24rpx rgba(255, 159, 28, 0.3);
}

.hello {
  font-size: 40rpx;
  font-weight: 800;
}

.hero .sub {
  font-size: 26rpx;
  opacity: 0.95;
  margin-top: 8rpx;
}

.hero-icon {
  font-size: 88rpx;
}

.stats-row {
  display: flex;
  justify-content: space-between;
}

.stat {
  flex: 1;
  margin-right: 16rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.stat:last-child {
  margin-right: 0;
}

.stat .num {
  font-size: 44rpx;
  font-weight: 800;
  color: #FF8A00;
}

.stat .lbl {
  font-size: 22rpx;
  color: #999;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.feature {
  width: 48.5%;
  box-sizing: border-box;
}

.f-icon {
  font-size: 56rpx;
}

.f-title {
  font-size: 32rpx;
  font-weight: 800;
  margin-top: 8rpx;
}

.f-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.tip-title {
  font-weight: 800;
  color: #4D96FF;
  margin-bottom: 8rpx;
}

.tip-text {
  color: #555;
}
