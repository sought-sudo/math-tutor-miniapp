<view class="page">
  <view class="card summary">
    <view class="s-item">
      <view class="s-num">{{actives.length}}</view>
      <view class="s-lbl">待复习</view>
    </view>
    <view class="s-item">
      <view class="s-num green">{{mastered.length}}</view>
      <view class="s-lbl">已掌握</view>
    </view>
  </view>

  <view class="tabs">
    <view class="tab {{tab === 'active' ? 'on' : ''}}" data-tab="active" bindtap="switchTab">待复习</view>
    <view class="tab {{tab === 'mastered' ? 'on' : ''}}" data-tab="mastered" bindtap="switchTab">已掌握</view>
  </view>

  <block wx:if="{{tab === 'active'}}">
    <view wx:if="{{!actives.length}}" class="card">
      <view class="empty">📭 还没有错题，太棒了！</view>
      <view class="empty-sub">做错的题会自动收进来，记得常来复习</view>
    </view>
    <view wx:for="{{activeGroups}}" wx:key="knowledge" class="wrong-group">
      <view class="wg-head">
        <view class="tag">{{item.knowledge}}</view>
        <view class="w-times">{{item.items.length}} 道</view>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="it" wx:key="id" class="card wrong-item">
        <view class="w-problem">{{it.problem}}</view>
        <view class="w-ans bad">✗ 我的答案：{{it.myAnswer}}</view>
        <view class="w-ans good">✓ 正确答案：{{it.rightAnswer}}</view>
        <view class="w-btns">
          <view class="btn btn-primary btn-small" data-id="{{it.id}}" bindtap="explain">重新学习</view>
          <view class="btn btn-green btn-small" data-id="{{it.id}}" bindtap="variant">变形题</view>
          <view class="btn btn-ghost btn-small" data-id="{{it.id}}" bindtap="master">掌握啦</view>
          <view class="btn btn-ghost btn-small" data-id="{{it.id}}" bindtap="remove">删除</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:else>
    <view wx:if="{{!mastered.length}}" class="card">
      <view class="empty">🌱 还没有掌握的错题</view>
      <view class="empty-sub">继续加油，做对的错题会出现在这里</view>
    </view>
    <view wx:for="{{masteredGroups}}" wx:key="knowledge" class="wrong-group">
      <view class="wg-head">
        <view class="tag">{{item.knowledge}}</view>
        <view class="w-times">{{item.items.length}} 道</view>
      </view>
      <view wx:for="{{item.items}}" wx:for-item="it" wx:key="id" class="card wrong-item mastered-item">
        <view class="w-problem">{{it.problem}}</view>
        <view class="w-ans good">✓ 正确答案：{{it.rightAnswer}}</view>
        <view class="w-btns">
          <view class="btn btn-blue btn-small" data-id="{{it.id}}" bindtap="explain">重新学习</view>
          <view class="btn btn-ghost btn-small" data-id="{{it.id}}" bindtap="remove">删除</view>
        </view>
      </view>
    </view>
    <view wx:if="{{mastered.length}}" class="btn btn-ghost" bindtap="clearMastered">清空已掌握</view>
  </block>

  <bottom-nav current="wrong" />
</view>
